# Copy to .env (never commit it).
ANTHROPIC_API_KEY=            # for the Leads, Campaign, Voice and Inbox screens (ask Lukas)
DEMO_PASSCODE=                # required: protects every API route; use a long random value
# Live sending with outreach/send.py --live. Mail goes to TEST_RECIPIENT unless --to-prospects is added.
TEST_RECIPIENT=you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Your Name <you@example.com>
